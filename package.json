{
  "name": "microlaudo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "dev:web": "expo start --web",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "build:web": "expo export --platform web && node scripts/fix-web-assets.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts,.tsx",
    "types": "tsc --noEmit",
    "db:migrate": "node -e \"console.error('Nao use supabase db push: o historico remoto usa outra numeracao e ele reaplicaria tudo desde a 001. Rode o SQL da migration nova no SQL Editor e depois: npm run db:types'); process.exit(1)\"",
    "db:reset": "npx supabase db reset",
    "db:types": "npx supabase gen types typescript --remote --schema public > src/types/database.generated.ts",
    "db:seed": "npx supabase db seed",
    "audit": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run lint && npm run types"
  },
  "dependencies": {
    "@expo-google-fonts/figtree": "^0.3.1",
    "@expo-google-fonts/noto-sans": "^0.3.0",
    "@expo/vector-icons": "^15.1.1",
    "@supabase/supabase-js": "^2.44.0",
    "expo": "~57.0.33",
    "expo-auth-session": "~57.0.17",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.21",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.21",
    "expo-linking": "~57.0.14",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.31",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.26",
    "expo-splash-screen": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "i18next": "^23.15.0",
    "jspdf": "^4.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^14.1.0",
    "react-native": "^0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@react-native/jest-preset": "^0.86.3",
    "@types/react": "~19.2.4",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "prettier": "^3.3.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
